# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Obtain a key from https://aistudio.google.com/apikey and set it in your secure environment / Secrets panel.
GEMINI_API_KEY=your_gemini_api_key_here

# GEMINI_MODEL: Configurable Gemini model alias for academic generation tasks.
GEMINI_MODEL=gemini-4-hydrogen

# APP_URL: The URL where this applet is hosted.
APP_URL=MY_APP_URL
